pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                dir('java-cicd') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('java-cicd') {
                    sh 'mvn test'
                }
            }
        }

        stage('Verify JAR') {
            steps {
                dir('java-cicd') {
                    sh 'ls -lh target/'
                }
            }
        }
    }

    post {
        success {
            echo 'Build completed successfully!'
        }

        failure {
            echo 'Build failed. Check the failed stage.'
        }
    }
}
