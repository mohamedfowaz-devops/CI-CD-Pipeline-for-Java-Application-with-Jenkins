pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

       stage('Build and Test') {
    steps {
        dir('java-cicd') {
            sh 'mvn clean package'
            sh 'mvn test'
            sh 'mvn deploy'
        }
    }
}

    stage('Docker Build') {
            steps {
        dir('java-cicd') {
            sh 'docker build -t java-cicd-demo:${BUILD_NUMBER} .'
        }
    }
    }
        

        stage('Docker Image Check') {
            steps {
               sh 'docker images java-cicd-demo:${BUILD_NUMBER}'
            }
        }
        stage('Push to ECR') {
    steps {
        sh '''
            aws ecr get-login-password --region us-west-2 | \
            docker login --username AWS --password-stdin \
            582600397550.dkr.ecr.us-west-2.amazonaws.com

            docker tag java-cicd-demo:${BUILD_NUMBER} \
            582600397550.dkr.ecr.us-west-2.amazonaws.com/java-cicd-demo:${BUILD_NUMBER}

            docker push \
            582600397550.dkr.ecr.us-west-2.amazonaws.com/java-cicd-demo:${BUILD_NUMBER}
        '''
    }
            stage('Deploy with Ansible') {
    steps {
        sh '''
            ansible-playbook \
            -i ansible/inventory \
            ansible/deploy.yml
        '''
    }
}
}
    }

    post {
        success {
            echo 'Build and Docker image creation successful!'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage.'
        }
    }
}
